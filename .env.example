# =============================================
# 栖缘社 — Docker Compose 环境变量（根目录 .env）
# 本文件由 docker-compose.yml 读取，用于容器启动时的变量替换
# 复制此文件为 .env 并修改对应值后 docker compose up -d
# =============================================
#
# 生产环境部署前必须修改以下项（否则有安全风险）：
#   [ ] MYSQL_ROOT_PASSWORD  — 强密码，至少 16 位
#   [ ] MYSQL_PASSWORD       — 强密码，至少 16 位
#   [ ] REDIS_PASSWORD       — 强密码，至少 16 位
#   [ ] JWT_SECRET           — 随机字符串，至少 32 位（生成方式: openssl rand -hex 32）
#   [ ] ADMIN_JWT_SECRET     — 随机字符串，至少 32 位，必须与 JWT_SECRET 不同
#   [ ] WECHAT_APPID         — 微信小程序 AppID
#   [ ] WECHAT_SECRET        — 微信小程序 AppSecret
#   [ ] DOMAIN               — 服务器域名
#   [ ] SSL_EMAIL            — Let's Encrypt 证书续期通知邮箱
#
# 除本文件外，backend/.env（从 backend/.env.example 复制）中还有三项必须在生产设置，
# 否则应用会启动失败或相关功能不可用：
#   [ ] IDENTITY_ENCRYPTION_KEY — 实名信息加密密钥（openssl rand -hex 32），未设置生产启动会中止
#   [ ] AI_ENCRYPT_KEY          — AI API Key 加密密钥（openssl rand -hex 32），未设置则 AI 加密报错
#   [ ] ADMIN_RESET_KEY         — 管理员忘记密码重置密钥，未设置则重置密码接口不可用
#
# 服务器资源分配参考（4C4G 腾讯云轻量服务器）：
#   MySQL:  768MB（innodb_buffer_pool_size=384M）
#   Redis:  256MB（maxmemory=256mb）
#   API:    1280MB（max-old-space-size=768M）
#   Admin:  128MB / Nginx: 64MB
#   剩余:   ~900MB 用于操作系统和缓冲
# =============================================

# ============ 前端构建变量（Vite） ============
# 小程序/管理后台调用后端 API 的基础 URL（本地开发用 localhost，生产用域名）
VITE_API_BASE_URL=https://date.arvine.cn/api

# 小程序版本号（显示在"我的"页面底部）
VITE_APP_VERSION=v5.0.0

# ============ 数据库配置（MySQL 8.0 容器） ============
# MySQL root 用户密码（容器首次启动时创建）
MYSQL_ROOT_PASSWORD=lingtong_root_2024_secure

# MySQL 自动创建的数据库名
MYSQL_DATABASE=lingtong_match

# MySQL 普通用户（应用连接使用，非 root）
MYSQL_USER=lingtong

# MySQL 普通用户密码（应用连接使用）
MYSQL_PASSWORD=lingtong_pass_2024_secure

# 应用启动时是否自动同步数据库表结构（TypeORM synchronize）
# ⚠️⚠️⚠️ 生产环境必须设为 false！设为 true 会在启动时自动删表/改表，导致数据丢失
# 本地开发可设为 true 以自动根据 Entity 变更建表，无需手动 migration
DB_SYNC=false

# ============ Redis 配置（Redis 7 Alpine 容器） ============
# Redis 访问密码（应用连接使用）
REDIS_PASSWORD=lingtong_redis_2024_secure

# ============ JWT 配置（用户端） ============
# 用户端 JWT 签名密钥（至少 32 字符随机字符串，生产环境务必修改）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars

# 用户端 JWT 过期时间（格式：数字+单位，如 7d / 24h / 60m）
JWT_EXPIRES_IN=7d

# ============ Admin JWT 配置（管理后台，必须与用户端密钥不同） ============
# 管理后台 JWT 签名密钥（务必与 JWT_SECRET 不同，防止用户端 token 越权访问管理后台）
ADMIN_JWT_SECRET=admin-jwt-secret-key-change-this

# 管理后台 JWT 过期时间（建议比用户端短，提升安全性）
ADMIN_JWT_EXPIRES_IN=24h

# ============ 微信小程序配置 ============
# 微信小程序 AppID（从微信公众平台 → 开发管理获取）
WECHAT_APPID=your-wechat-appid

# 微信小程序 AppSecret（从微信公众平台 → 开发管理获取，务必保密）
WECHAT_SECRET=your-wechat-appsecret

# ============ 微信支付配置（微信商户平台） ============
# 微信支付商户号（从微信支付商户平台获取，为空则不发起真实支付）
WECHAT_MCH_ID=your-mch-id

# 微信支付 API V3 密钥（32 字符，在商户平台 → API安全 设置）
WECHAT_API_V3_KEY=your-api-v3-key

# 微信支付商户 API 私钥（PEM 格式，\n 换行，用于 V3 签名）
WECHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----

# 微信支付商户 API 证书序列号（商户平台 → API安全 → API证书）
WECHAT_MCH_SERIAL_NO=your-cert-serial-no

# 微信支付回调通知 URL（必须公网 HTTPS）
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/notify

# 微信支付平台证书 PEM（回调验签，多个用分号分隔）
WECHAT_PLATFORM_CERT_PEM=-----BEGIN CERTIFICATE-----\nyour-cert\n-----END CERTIFICATE-----

# 微信支付回调 IP 白名单（逗号分隔，支持 CIDR，留空则拒绝所有外部回调）
# 官方回调 IP 段：https://pay.weixin.qq.com/doc/v3/merchant/4014360729
WECHAT_CALLBACK_IP_WHITELIST=

# ============ 服务器配置 ============
# 服务器域名（用于 Nginx SSL 证书、CORS 白名单等）
DOMAIN=yourdomain.com

# CORS 允许的前端域名（多个用英文逗号分隔，生产环境必须配置）
CORS_ORIGINS=https://yourdomain.com

# 后端 API 基础 URL（前端 Vue/uni-app 发起请求使用）
# 本地开发设 http://localhost:3000；生产设 https://yourdomain.com/api
API_BASE_URL=https://yourdomain.com

# 静态资源（uploads 下的语音/图片等）对外访问基础 URL
# 必须为不带 /api、不带结尾斜杠的站点根域名，例如 https://yourdomain.com
# 用于生成 /uploads/xxx 的绝对地址（语音介绍等），配错会导致管理后台/他端无法播放
STATIC_BASE_URL=https://yourdomain.com

# 管理后台基础 URL（用于生成管理后台链接，如邮件中的链接）
ADMIN_BASE_URL=https://yourdomain.com

# ============ SSL 证书路径（用于 Nginx 自动配置 HTTPS） ============
# Let's Encrypt 注册邮箱（certbot 申请/续期证书使用）
SSL_EMAIL=admin@yourdomain.com

# SSL 证书文件路径（容器内，由 certbot 或手动挂载提供）
SSL_CERT_PATH=./docker/nginx/ssl/fullchain.pem
SSL_KEY_PATH=./docker/nginx/ssl/privkey.pem

# ============ 数据库备份配置（scripts/backup.sh 脚本使用） ============
# 备份文件保留天数（超过此天数的 .sql.gz 备份会被自动清理）
BACKUP_RETENTION_DAYS=30

# 备份文件存储路径（相对于项目根目录）
BACKUP_PATH=./backups

# 是否启用远程备份（将备份文件同步到 OSS/COS，需额外配置对象存储凭证）
ENABLE_REMOTE_BACKUP=false

# ============ 监控与告警配置 ============
# 服务器资源监控（CPU / 内存 / 磁盘 / 带宽）：
#   腾讯云轻量应用服务器控制台 → 实例详情 → 监控 标签页，免费提供实时图表和告警策略。
#   建议设置：「内存使用率 > 85%」「磁盘使用率 > 80%」「CPU 使用率 > 90%」的告警。
#
# 外部 HTTP 存活监控（免费 50 个监控项）：
#   注册 UptimeRobot（uptimerobot.com），添加监控项监测 https://yourdomain.com/api/health
#   宕机时自动发送邮件 / 企业微信 / 飞书通知。
#
# 应用层告警（审核通知等）通过以下 Webhook 通道发送，由 notify-channel.service.ts 驱动：
#
# 企业微信机器人 Webhook URL（用于发送系统告警通知，留空则不发送）
WECHAT_WEBHOOK_URL=

# 飞书机器人 Webhook URL（留空则不发送）
FEISHU_WEBHOOK_URL=

# 钉钉机器人 Webhook URL（留空则不发送）
DINGTALK_WEBHOOK_URL=
