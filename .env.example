# =============================================
# 栖缘社 — 环境变量配置（唯一配置源）
# =============================================
# 本文件是项目唯一的 .env 示例。Docker Compose 部署与本地/手动部署共用同一份 .env。
#
# 使用方法：
#   cp .env.example .env
#   vim .env     # 按需修改后启动
#
# 两种部署方式的读取逻辑：
#   - Docker Compose：compose 通过 env_file 将本文件注入 api 容器，
#     并用 environment 块覆盖「容器网络专用值」（DB_HOST=mysql、REDIS_HOST=redis 等）。
#   - 本地/手动部署：NestJS 应用直接读取本文件（process.env.*），
#     此时需将 DB_HOST / REDIS_HOST 指向 localhost（或本机 MySQL/Redis 地址）。
#
# ============ 上线前必须修改（否则有安全或功能风险）============
#   [ ] MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD / REDIS_PASSWORD — 强密码
#   [ ] JWT_SECRET / ADMIN_JWT_SECRET / JWT_MFA_SECRET         — 随机串（openssl rand -hex 32）
#   [ ] IDENTITY_ENCRYPTION_KEY / AI_ENCRYPT_KEY / ADMIN_RESET_KEY — 随机串（openssl rand -hex 32）
#   [ ] WECHAT_APPID / WECHAT_SECRET                           — 微信小程序凭证
#   [ ] WECHAT_MCH_ID / WECHAT_API_V3_KEY / WECHAT_PRIVATE_KEY / WECHAT_MCH_SERIAL_NO — 微信支付 V3
#   [ ] DOMAIN / CORS_ORIGINS / SSL_EMAIL                      — 域名与证书
# =============================================

# ============ 应用配置 ============
# 运行环境（development / production）。Docker 容器内固定为 production。
NODE_ENV=development

# 后端监听端口。Docker 容器内固定为 3000。
PORT=3000

# ============ 数据库配置（MySQL 8.0） ============
# Docker Compose：以下 MYSQL_* 用于初始化 MySQL 容器，并为 api 容器注入连接信息。
# 本地/手动部署：可忽略 MYSQL_*，直接使用下方 DB_* 连接本机 MySQL。

# MySQL root 密码（容器首次启动时创建）
MYSQL_ROOT_PASSWORD=lingtong_root_2024_secure

# MySQL 自动创建的数据库名
MYSQL_DATABASE=lingtong_match

# MySQL 普通用户（应用连接使用，非 root）
MYSQL_USER=lingtong

# MySQL 普通用户密码（应用连接使用）
MYSQL_PASSWORD=lingtong_pass_2024_secure

# --- 应用连接参数（NestJS 直接读取）---
# Docker 部署下由 compose 覆盖为 mysql/3306；本地/手动部署请按实际填写。
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=lingtong
DB_PASSWORD=lingtong_pass_2024_secure
DB_DATABASE=lingtong_match

# 连接池最大连接数（建议 ≤ MySQL max_connections）
DB_POOL_SIZE=20

# 获取连接超时（毫秒）：排队超时即抛错，避免请求无限挂起
DB_ACQUIRE_TIMEOUT=10000

# 空闲连接回收（毫秒）
DB_IDLE_TIMEOUT=60000

# 是否启动时自动同步 TypeORM 实体 → 表结构。⚠️ 生产环境必须为 false。
DB_SYNC=false

# 是否跳过启动时自动创建索引（已用 migration 管理索引时可设 true）
DB_SKIP_AUTO_INDEX=false

# ============ Redis 配置 ============
# Redis 访问密码（容器密码与应用连接密码共用）
REDIS_PASSWORD=lingtong_redis_2024_secure

# --- 应用连接参数（NestJS 直接读取）---
# Docker 部署下由 compose 覆盖为 redis/6379；本地/手动部署请按实际填写。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============ JWT 配置（用户端） ============
# 用户端 JWT 签名密钥（至少 32 字符随机串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars

# 用户端 JWT 过期时间（格式：数字+单位，如 7d / 24h / 60m）
JWT_EXPIRES_IN=7d

# accessToken 有效期（短期令牌，过期后用 refreshToken 自动续期）
ACCESS_TOKEN_EXPIRES_IN=30m

# refreshToken 有效期（用于自动续期的长期令牌）
REFRESH_TOKEN_EXPIRES_IN=7d

# ============ Admin JWT 配置（管理后台，必须与用户端密钥不同） ============
ADMIN_JWT_SECRET=admin-jwt-secret-key-change-this

# 管理后台 JWT 过期时间
ADMIN_JWT_EXPIRES_IN=24h

# 管理后台 refreshToken 有效期
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d

# ============ MFA 临时令牌 ============
# MFA 两步验证登录流程中间态的临时令牌签名密钥
JWT_MFA_SECRET=mfa-temp-token-secret-change-this

# ============ 管理员密码重置 ============
# 管理员忘记密码时通过此密钥重置（调用 /api/admin/reset-password 需携带）。
# 未设置则重置密码接口不可用。生成：openssl rand -hex 32
ADMIN_RESET_KEY=your-admin-reset-key-change-this

# 首次启动（admin_users 表为空）自动创建默认管理员 admin 的初始密码。
# 未设置：随机生成 16 位（生产环境日志脱敏，可能无法获取）；建议显式设置。
ADMIN_DEFAULT_PASSWORD=

# ============ 微信小程序配置 ============
WECHAT_APPID=your-wechat-appid

WECHAT_SECRET=your-wechat-appsecret

# ============ 微信支付配置（API V3） ============
# 商户号
WECHAT_MCH_ID=your-mch-id

# API V3 密钥（32 字符，商户平台 → API安全 设置）
WECHAT_API_V3_KEY=your-api-v3-key

# 商户 API 私钥（PEM 格式，用于 V3 签名，\n 转义换行）
WECHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----

# 商户 API 证书序列号（商户平台 → API安全 → API证书）
WECHAT_MCH_SERIAL_NO=your-cert-serial-no

# 支付回调通知 URL（必须公网 HTTPS）
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/notify

# 平台证书 PEM（回调验签，多个用分号分隔）
WECHAT_PLATFORM_CERT_PEM=-----BEGIN CERTIFICATE-----\nyour-platform-cert-here\n-----END CERTIFICATE-----

# 回调 IP 白名单（逗号分隔，支持 CIDR，留空则拒绝所有外部回调）
WECHAT_CALLBACK_IP_WHITELIST=

# 模拟支付开关：true 时允许走模拟支付（无需真实商户号，仅联调/测试用）
MOCK_PAY_ENABLED=false

# ============ 腾讯云配置 ============
# 注意：项目中有两套腾讯云密钥，用途不同、互不通用：
#   1) TENCENT_SECRET_ID / TENCENT_SECRET_KEY — 通用密钥，E证通实名认证（OCR/人脸核身）回退使用
#   2) TC_SECRET_ID / TC_SECRET_KEY / TC_REGION — 内容安全审核（文本/图片审核）专用

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 内容安全审核专用（留空则跳过内容审核）
TC_SECRET_ID=
TC_SECRET_KEY=
TC_REGION=ap-guangzhou

# ============ 腾讯云 E证通实名认证（人脸核身 + 身份证 OCR） ============
# E证通商户号（腾讯云人脸核身控制台 → E证通 申请）
EID_MERCHANT_ID=

# E证通/OCR 使用的腾讯云密钥；留空则复用上方 TENCENT_SECRET_ID / TENCENT_SECRET_KEY
EID_SECRET_ID=
EID_SECRET_KEY=

# 接口区域
EID_REGION=ap-guangzhou

# 异步回调验签密钥（校验 /api/eid-auth/callback 回调，留空则拒绝所有回调）
EID_CALLBACK_TOKEN=

# ============ 敏感数据加密密钥 ============
# 实名身份信息加密密钥（AES-256-GCM，64 位十六进制 = 32 字节）。
# 必须设置，否则系统启动中止。生成：openssl rand -hex 32
IDENTITY_ENCRYPTION_KEY=

# 协议日志 SLS 存储凭证加密密钥（AES-256-CBC）。仅使用 SLS 存储且保存过 AccessKeySecret 时需要。
SLS_STORAGE_ENCRYPTION_KEY=

# ============ AI 多 Provider 配置 ============
# 支持同时配置 DeepSeek、Kimi、OpenAI、通义千问、文心一言等。
# 系统启动时加载到数据库，之后可通过管理后台实时调整（无需重启）。

# AES-256 加密密钥（加密存储数据库中的 API Key）。⚠️ 生成：openssl rand -hex 32；
# ⚠️ 一旦用此密钥加密过 API Key 就不可再改，否则已存密文无法解密。
AI_ENCRYPT_KEY=your-32-byte-encryption-key-here!

# 默认 AI Provider（deepseek / kimi / openai / qwen）
AI_DEFAULT_PROVIDER=deepseek

# AI 请求超时（毫秒）
AI_REQUEST_TIMEOUT=30000

# 全局余额告警阈值（元，预留字段）
AI_GLOBAL_BALANCE_ALERT_THRESHOLD=100

# --- DeepSeek ---
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_WEIGHT=60
DEEPSEEK_PRIORITY=1
DEEPSEEK_BALANCE_URL=

# --- Kimi (Moonshot) ---
KIMI_ENABLED=true
KIMI_API_KEY=sk-your-kimi-key
KIMI_API_BASE=https://api.moonshot.cn
KIMI_MODEL_NAME=moonshot-v1-8k
KIMI_WEIGHT=40
KIMI_PRIORITY=2
KIMI_BALANCE_URL=

# --- 可扩展：OpenAI ---
# OPENAI_ENABLED=false
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_API_BASE=https://api.openai.com
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_WEIGHT=30
# OPENAI_PRIORITY=3
# OPENAI_BALANCE_URL=

# --- 可扩展：通义千问（阿里云）---
# QWEN_ENABLED=false
# QWEN_API_KEY=sk-your-qwen-key
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode
# QWEN_MODEL_NAME=qwen-plus
# QWEN_WEIGHT=20
# QWEN_PRIORITY=4
# QWEN_BALANCE_URL=

# --- 可扩展：文心一言（百度）---
# ERNIE_ENABLED=false
# ERNIE_API_KEY=your-ernie-key
# ERNIE_API_BASE=https://aip.baidubce.com/rpc/2.0/ai_custom/v1
# ERNIE_MODEL_NAME=ernie-4.0-8k
# ERNIE_WEIGHT=10
# ERNIE_PRIORITY=5
# ERNIE_BALANCE_URL=

# ============ 阿里云百炼 — 语音转录（Qwen3-ASR-Flash） ============
QWEN_ASR_ENABLED=true
QWEN_ASR_API_KEY=sk-your-qwen-asr-key
QWEN_ASR_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL_NAME=qwen3-asr-flash
QWEN_ASR_WEIGHT=10
QWEN_ASR_PRIORITY=5

# 本地备份永久保留，不自动清理（true 时系统不执行任何定时清理逻辑）
LOCAL_BACKUP_RETAIN_FOREVER=true

# ============ 上传与 OSS/CDN 配置 ============
# 上传策略：local = 服务器本地 / oss = 对象存储（预留）
UPLOAD_STRATEGY=local

# 是否启用 CDN 返回地址
CDN_ENABLED=false

# CDN 加速域名
CDN_DOMAIN=

# CDN 回源类型：origin = 回源到服务器 / oss = 回源到 OSS
CDN_ORIGIN_TYPE=origin

# 阿里云 OSS（UPLOAD_STRATEGY=oss 时填写）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_PREFIX=uploads/

# 用户上传文件本地存储目录（留空默认使用进程工作目录下的 uploads/）
UPLOAD_DIR=

# 静态资源（/uploads 下的语音、图片等）对外访问的 URL 前缀。
# 生产环境必须设为站点根域名（不含 /api、不带结尾斜杠）；留空则回退 API_BASE_URL。
STATIC_BASE_URL=

# 后端 API 基础 URL（拼接资源地址的兜底，优先级低于 STATIC_BASE_URL）
API_BASE_URL=

# 管理后台访问地址（审核通知消息中「去处理」链接使用，留空则不携带链接）
ADMIN_URL=

# 人格测试分享页 H5 基础地址（生成分享链接用）
APP_SHARE_BASE_URL=https://yourdomain.com

# ============ 服务器与域名配置 ============
# 服务器域名（用于 Nginx SSL 证书等）
DOMAIN=yourdomain.com

# CORS 允许的前端域名（多个用英文逗号分隔）。本地开发留空则放行所有来源。
CORS_ORIGINS=https://yourdomain.com

# ============ 前端构建变量（Vite） ============
# 小程序/管理后台调用后端 API 的基础 URL
VITE_API_BASE_URL=https://date.arvine.cn/api

# 静态资源（上传图片/语音）访问 URL 前缀；留空则前端运行时动态推导（通常等于站点根域名）
VITE_STATIC_BASE_URL=https://date.arvine.cn

# 小程序版本号（显示在「我的」页面底部）
VITE_APP_VERSION=v5.0.0

# ============ SSL 证书配置 ============
# Let's Encrypt 注册邮箱（certbot 申请/续期使用）
SSL_EMAIL=admin@yourdomain.com

# SSL 证书文件路径（容器内，由 certbot 或手动挂载提供）
SSL_CERT_PATH=./docker/nginx/ssl/fullchain.pem
SSL_KEY_PATH=./docker/nginx/ssl/privkey.pem

# ============ 数据库备份配置（scripts/backup.sh 使用） ============
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups
ENABLE_REMOTE_BACKUP=false

# ============ 监控与告警配置（scripts/monitor.sh 使用） ============
WECHAT_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=

# ============ 日志配置 ============
# 日志级别（debug / verbose / info / warn / error），生产建议 info
LOG_LEVEL=debug

# 文件日志目录（Docker 容器内默认 /app/logs）
LOG_DIR=/app/logs

# 500 错误告警 Webhook URL（企业微信/飞书/钉钉机器人），不配置则不告警
ERROR_ALERT_WEBHOOK_URL=

# 实例标识（多实例部署时区分日志来源），默认取 hostname
INSTANCE_ID=
